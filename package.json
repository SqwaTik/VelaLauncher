{
  "name": "vela-launcher",
  "version": "0.1.4",
  "description": "Vela Launcher — a fast, beautiful Minecraft launcher",
  "author": "SqwaTik",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@vueuse/core": "^11.1.0",
    "@vueuse/motion": "^3.0.3",
    "@xmcl/core": "^2.15.1",
    "@xmcl/installer": "^6.1.2",
    "@xmcl/user": "^4.3.0",
    "discord-rpc": "^4.0.1",
    "dompurify": "^3.4.12",
    "extract-zip": "^2.0.1",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.7",
    "pinia": "^2.2.4",
    "skinview3d": "^3.4.2",
    "vue": "^3.5.12",
    "vue-easy-lightbox": "^1.19.0",
    "vue-router": "^4.4.5",
    "yauzl": "^2.10.0",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.11",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "prettier": "^3.9.6",
    "rcedit": "^5.0.2",
    "sass": "^1.80.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vue-tsc": "^2.1.6"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true
  },
  "build": {
    "appId": "io.vela.launcher",
    "productName": "Vela Launcher",
    "asar": true,
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "fileAssociations": [
        {
          "ext": "mrpack",
          "name": "Modrinth Modpack",
          "description": "Сборка Minecraft для Vela Launcher",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
